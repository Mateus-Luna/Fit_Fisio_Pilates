{
  "name": "fit_fisio_pilates",
  "version": "1.0.0",
  "description": "Sistema de gestão FitFisio Pilates",
  "main": "electron/main.cjs",
  "scripts": {
  "dev": "node server.js",
  "postinstall": "npm --prefix frontend install",
  "build": "npm --prefix frontend run build",
  "lint": "npm --prefix frontend run lint",
  "start": "node server.js",
  "electron": "electron .",
  "dist:win": "npm run build && electron-builder --win nsis"
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mateus-Luna/Fit_Fisio_Pilates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mateus-Luna/Fit_Fisio_Pilates/issues"
  },
  "homepage": "https://github.com/Mateus-Luna/Fit_Fisio_Pilates#readme",
  "devDependencies": {
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1"
  },
  "build": {
    "appId": "com.fitfisio.app",
    "productName": "FitFisio Pilates",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "frontend/dist/**/*",
      "backend/assets/documents/RECIBO SERVICO.pdf",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/assets/documents/RECIBO SERVICO.pdf",
        "to": "assets/documents/RECIBO SERVICO.pdf"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
